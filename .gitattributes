# 默认：文本按 LF 存储，检出时 LF
* text=auto eol=lf

# Windows 专属文件保持 CRLF
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf
*.sln        text eol=crlf
*.vcxproj    text eol=crlf
*.vcxproj.*  text eol=crlf

# 二进制：禁止任何换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.exe   binary
*.dll   binary
*.a     binary
*.o     binary
*.class binary
*.jar   binary
